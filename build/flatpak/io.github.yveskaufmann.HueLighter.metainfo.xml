<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.yveskaufmann.HueLighter</id>
  <name>Hue Lighter</name>
  <summary>Turn your Hue lights on at sunset and off at sunrise</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="io.github.yveskaufmann">
    <name>Yves Kaufmann</name>
  </developer>

  <launchable type="desktop-id">io.github.yveskaufmann.HueLighter.desktop</launchable>
  <provides>
    <binary>hue-lighter</binary>
  </provides>

  <description>
    <p>
      Hue Lighter automates the backlighting of your desktop PC: it turns the
      configured Philips Hue lights on at sunset and off at sunrise, and turns
      them off when you log out or shut down.
    </p>
    <p>
      A tray icon lets you switch the lights manually regardless of the time of day.
    </p>
  </description>


  <url type="homepage">https://github.com/yveskaufmann/hue-lighter</url>
  <url type="bugtracker">https://github.com/yveskaufmann/hue-lighter/issues</url>
  <url type="vcs-browser">https://github.com/yveskaufmann/hue-lighter</url>

  <screenshots>
    <screenshot type="default">
      <caption>Tray icon in the system tray - allows to manually control the light state</caption>
      <image type="source" width="816" height="216">
        https://raw.githubusercontent.com/yveskaufmann/hue-lighter/main/.github/screenshots/tray-icon.png</image>
    </screenshot>
    <screenshot type="default">
      <caption>Settings page to configure lights and location to correctly determine sunset and
        sunrise times</caption>
      <image type="source" width="1068" height="812">
        https://raw.githubusercontent.com/yveskaufmann/hue-lighter/main/.github/screenshots/settings.png</image>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="1.0.0" date="2026-11-14">
      <description>
        <p>Initial release of Hue Lighter.</p>
        <heading>Features</heading>
        <ul>
          <li>Hue Lighter automation service (<code>f0ce019</code>)</li>
          <li>Settings page for lights and location (<code>46f7e7e</code>)</li>
          <li>Tray icon for manual control (<code>9b3402d</code>)</li>
          <li>Local installation via Flatpak</li>
        </ul>
      </description>
    </release>
    <release version="1.1.0" date="2026-11-18">
      <description>
        <p>First release with distribution via Personal Flatpak Repository.</p>
        <heading>Features</heading>
        <ul>
          <li>Distribution via Personal Flatpak Repository</li>
        </ul>
      </description>
    </release>
  </releases>
</component>  